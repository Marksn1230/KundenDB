encode zstd gzip
# Preserve the access check before proxy handlers; Caddy otherwise sorts handle before respond.
route {
 @privateIdentity path /auth/admin* /auth/realms/master*
 respond @privateIdentity 404
 handle /auth/* {
  vars otp_policy force
  import mfa-allowlist.caddy
  reverse_proxy 172.30.93.3:8080 {
   header_up -Forwarded
   header_up X-Forwarded-For {remote_host}
   header_up X-Forwarded-Host {host}
   header_up X-Forwarded-Proto {scheme}
   header_up X-Kundenraum-OTP-Policy {http.vars.otp_policy}
  }
 }
 handle {
  reverse_proxy web:3000
 }
}
header X-Content-Type-Options "nosniff"
header Referrer-Policy "same-origin"
