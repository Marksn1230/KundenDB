# Server-Vorlage: kopieren und scripts/setup-server.mjs verwenden.
APP_VERSION=0.4.0
APP_DOMAIN=kunden.example.at
HTTPS_ENABLED=true
ACME_EMAIL=admin@example.com
# Nur für wiederholte Ausstellungstests auf staging setzen.
ACME_ENV=production
# Öffentliche Server-IP(s), mehrere mit Komma, für die DNS-Prüfung.
SERVER_PUBLIC_IPS=
POSTGRES_ADMIN_PASSWORD=GENERIEREN
POSTGRES_PASSWORD=GENERIEREN
DATABASE_URL=GENERIEREN
KEYCLOAK_DB_ADMIN_PASSWORD=GENERIEREN
KEYCLOAK_DB_PASSWORD=GENERIEREN
SESSION_ENCRYPTION_KEY=GENERIEREN
OIDC_CLIENT_SECRET=GENERIEREN
KEYCLOAK_ADMIN_USER=bootstrap
KEYCLOAK_ADMIN_PASSWORD=GENERIEREN
INITIAL_ADMIN_USERNAME=persoenlicher-benutzername
INITIAL_ADMIN_PASSWORD=GENERIEREN
WHATSAPP_API_VERSION=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_LANGUAGE=de
WHATSAPP_TEST_NUMBER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
